          "default": "#FFFFFF",
          "title": "Color",
          "type": "string"
        },
        "highlight_color": {
          "default": "#FFE600",
          "title": "Highlight Color",
          "type": "string"
        },
        "stroke_color": {
          "default": "#000000",
          "title": "Stroke Color",
          "type": "string"
        },
        "stroke_width": {
          "default": 6,
          "title": "Stroke Width",
          "type": "integer"
        },
        "uppercase": {
          "default": true,
          "title": "Uppercase",
          "type": "boolean"
        },
        "position": {
          "default": "bottom",
          "enum": [
            "top",
            "middle",
            "bottom"
          ],
          "title": "Position",
          "type": "string"
        },
        "words_per_line": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Words Per Line",
          "type": "integer"
        },
        "animation": {
          "default": "pop",
          "enum": [
            "karaoke",
            "pop",
            "typewriter",
            "bounce"
          ],
          "title": "Animation",
          "type": "string"
        },
        "box": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box"
        }
      },
      "title": "CaptionStyle",
      "type": "object"
    },
    "CutTransition": {
      "additionalProperties": false,
      "description": "An animated transition into the shot or piece that starts at source time `at` (ADR 0613).\n\nThe last frame before it is held and animated away over the incoming footage: drop (it falls off the\nbottom of the frame), whip (a fast blurred pan sideways), zoom (it pushes through toward the viewer),\npush (it slides up as the new shot slides in). Used sparingly, at shot and topic changes.",
      "properties": {
        "at": {
          "minimum": 0,
          "title": "At",
          "type": "number"
        },
        "kind": {
          "default": "drop",
          "enum": [
            "drop",
            "whip",
            "zoom",
            "push"
          ],
          "title": "Kind",
          "type": "string"
        },
        "length": {
          "default": 0.5,
          "maximum": 1.2,
          "minimum": 0.2,
          "title": "Length",
          "type": "number"
        }
      },
      "required": [
        "at"
      ],
      "title": "CutTransition",
      "type": "object"
    },
    "Depth": {
      "additionalProperties": false,
      "description": "Effects around the speaker (ADR 0901), and, only when asked, the speaker cut out of the frame.\n\nOff unless the user asks for it in their style prompt or in the editor. The cut-out (`cutout`) is a\nsecond, narrower opt-in: a different background or things behind the speaker (ADR 0614).",
      "properties": {
        "enabled": {
          "default": false,
          "description": "True only if the user explicitly asks for a green-screen look: text or graphics behind the speaker, things happening around or in front of the speaker, a removed, replaced, blurred or dimmed background, or a 3D/depth effect.",
          "title": "Enabled",
          "type": "boolean"
        },
        "cutout": {
          "default": false,
          "description": "True only if the user specifically asks for a different background (removed, replaced, blurred or dimmed) or for text or graphics behind the speaker. Otherwise every effect is animated over the real footage and the speaker is never cut out (ADR 0614).",
          "title": "Cutout",
          "type": "boolean"
        },
        "background": {
          "default": "original",
          "enum": [
            "original",
            "blur",
            "dim",
            "color",
            "gradient",
            "media"
          ],
          "title": "Background",
          "type": "string"
        },
        "behind_titles": {
          "default": true,
          "title": "Behind Titles",
          "type": "boolean"
        },
        "around": {
          "default": true,
          "title": "Around",
          "type": "boolean"
        }
      },
      "title": "Depth",
      "type": "object"
    },
    "Graphic": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
