{
  "$defs": {
    "BackgroundSpan": {
      "additionalProperties": false,
      "description": "What is behind the cut-out speaker for a stretch of the source (needs `style.depth.cutout`).\n\noriginal: the real background. blur: the real background out of focus. dim: darkened, a spotlight on\nthe speaker. color / gradient: the studio set (a grid floor and wall, never a flat colour, ADR 0613), its\nlight washed with `color` (default: untinted).\nmedia: an imported picture or clip (`src`, a file in the job folder). Outside every span the style's\n`depth.background` applies.",
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "number"
        },
        "kind": {
          "default": "blur",
          "enum": [
            "original",
            "blur",
            "dim",
            "color",
            "gradient",
            "media"
          ],
          "title": "Kind",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "src": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src"
        },
        "parallax": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Parallax",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "BackgroundSpan",
      "type": "object"
    },
    "Camera": {
      "additionalProperties": false,
      "properties": {
        "zoom_frequency": {
          "default": "medium",
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "title": "Zoom Frequency",
          "type": "string"
        },
        "zoom_scale": {
          "default": 1.15,
          "maximum": 2,
          "minimum": 1,
          "title": "Zoom Scale",
          "type": "number"
        }
      },
      "title": "Camera",
      "type": "object"
    },
    "CaptionStyle": {
      "additionalProperties": false,
      "properties": {
        "font": {
          "default": "Montserrat",
          "description": "One of: Montserrat, Inter, Poppins, Bebas Neue, Anton, Oswald, Archivo Black, Playfair Display, Instrument Serif, Archivo Expanded, Permanent Marker, Bangers",
          "title": "Font",
          "type": "string"
        },
        "weight": {
          "default": 800,
          "title": "Weight",
          "type": "integer"
        },
        "size": {
