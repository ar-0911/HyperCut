          "type": "string"
        },
        "layer": {
          "default": "front",
          "enum": [
            "front",
            "behind"
          ],
          "title": "Layer",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "id",
        "type"
      ],
      "title": "Graphic",
      "type": "object"
    },
    "GraphicsStyle": {
      "additionalProperties": false,
      "properties": {
        "density": {
          "default": "balanced",
