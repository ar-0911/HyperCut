# Copy to .env and fill in. Only the lines for the options you pick matter.

# --- Claude (writes the edit plan). Pick one. ---
# cli = your Claude subscription (Pro/Max). Run `claude setup-token` on your computer and paste the token here.
HYPERCUT_LLM=cli
CLAUDE_CODE_OAUTH_TOKEN=
# api = pay per use with an Anthropic API key from https://console.anthropic.com
# HYPERCUT_LLM=api
# ANTHROPIC_API_KEY=
# Optional: a different Claude model (default: Claude Code's default for cli, claude-opus-5-5 for api).
# HYPERCUT_MODEL=

# --- Transcription. Pick one. ---
# whisper = runs on this computer, free, audio never leaves it. Model: tiny, base, small (default), medium, large-v3.
HYPERCUT_TRANSCRIBE=whisper
HYPERCUT_WHISPER_MODEL=small
# deepgram = cloud, faster on slow machines; uploads the audio to Deepgram.
# HYPERCUT_TRANSCRIBE=deepgram
# DEEPGRAM_API_KEY=

# --- Stock footage and generated pictures (optional, ADR 0016). Off unless set. ---
# Real B-roll from stock libraries (free keys): https://www.pexels.com/api/ and https://pixabay.com/api/docs/
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# Wikimedia Commons photos too (no key; only public-domain, CC0 and CC BY, credited on screen):
# HYPERCUT_STOCK=commons
# Generated pictures and clips through fal.ai (pay per use, about $0.05 a picture and $0.30 a 5 s clip):
# FAL_KEY=
# HYPERCUT_GEN_IMAGE_MODEL=fal-ai/flux-2-pro
# HYPERCUT_GEN_VIDEO_MODEL=fal-ai/kling-video/v2.1/standard/image-to-video
# HYPERCUT_GEN_VIDEO=1            # 0 keeps the 3D motion graphics instead of generated clips
# HYPERCUT_GEN_BUDGET_USD=2       # most a single video may spend on generation
# Or open models on this computer instead (CUDA GPU, 16-24 GB; pip install -e '.[local-gen]', outside Docker):
# HYPERCUT_GEN_LOCAL=1
