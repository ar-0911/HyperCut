{
  "name": "hypercut-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders a HyperCut edit plan to a 1080x1920 mp4 with HyperFrames",
  "scripts": {
    "build": "node scripts/build.mjs",
    "render": "node scripts/build.mjs && node dist/render.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "esbuild": "0.24.0",
    "hyperframes": "0.8.207",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
